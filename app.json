{
  "expo": {
    "name": "CampusFix",
    "slug": "campusfix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser", ["expo-image-picker", { "photosPermission": "CampusFix needs access to your photos to attach them to complaints.", "cameraPermission": "CampusFix needs camera access to take photos of campus problems." }]],
    "experiments": {
      "typedRoutes": true
    }
  }
}
